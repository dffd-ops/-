#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#define MAX 5

char board[MAX][MAX];
int size;

void init_board() {
    for (int i = 0; i < size; i++)
        for (int j = 0; j < size; j++)
            board[i][j] = ' ';
}

void print_board() {
    printf("\n    ");
    for (int i = 0; i < size; i++) printf("%d   ", i + 1);
    printf("\n");

    for (int i = 0; i < size; i++) {
        printf("%d ", i + 1);
        for (int j = 0; j < size; j++) {
            printf(" %c ", board[i][j]);
            if (j < size - 1) printf("|");
        }
        printf("\n");

        if (i < size - 1) {
            printf("  ");
            for (int j = 0; j < size; j++) {
                printf("---");
                if (j < size - 1) printf("+");
            }
            printf("\n");
        }
    }
    printf("\n");
}

int check_win(char s) {
    for (int i = 0; i < size; i++) {
        int row_ok = 1, col_ok = 1;
        for (int j = 0; j < size; j++) {
            if (board[i][j] != s) row_ok = 0;
            if (board[j][i] != s) col_ok = 0;
        }
        if (row_ok || col_ok) return 1;
    }

    int ok = 1;
    for (int i = 0; i < size; i++)
        if (board[i][i] != s) ok = 0;
    if (ok) return 1;

    ok = 1;
    for (int i = 0; i < size; i++)
        if (board[i][size - 1 - i] != s) ok = 0;
    if (ok) return 1;

    return 0;
}

int is_full() {
    for (int i = 0; i < size; i++)
        for (int j = 0; j < size; j++)
            if (board[i][j] == ' ') return 0;
    return 1;
}

void bot_move(char bot_sym) {
    int free_cells[MAX * MAX][2];
    int n = 0;

    for (int i = 0; i < size; i++)
        for (int j = 0; j < size; j++)
            if (board[i][j] == ' ') {
                free_cells[n][0] = i;
                free_cells[n][1] = j;
                n++;
            }

    if (n == 0) return;

    int pick = rand() % n;
    int row = free_cells[pick][0];
    int col = free_cells[pick][1];

    board[row][col] = bot_sym;
    printf("Бот поставил %c в (%d, %d)\n", bot_sym, row + 1, col + 1);
}

int main() {
    srand(time(NULL));

    printf("КРЕСТИКИ-НОЛИКИ\n");

    int mode;
    printf("Выберите режим игры:\n");
    printf("1. Игрок против Игрока\n");
    printf("2. Игрок против Бота\n");
    printf("Ваш выбор (1 или 2): ");
    if (scanf("%d", &mode) != 1 || (mode != 1 && mode != 2)) {
        printf("Ошибка ввода. Включаю режим с ботом.\n");
        mode = 2;
    }

    printf("\nВведите размер поля (от 3 до %d): ", MAX);
    if (scanf("%d", &size) != 1) {
        printf("Ошибка ввода.\n");
        return 1;
    }

    if (size < 3 || size > MAX) {
        printf("Неверный размер. Использую 3.\n");
        size = 3;
    }

    init_board();

    int current_turn = rand() % 2;
    char p1_sym = 'X', p2_sym = '0';
    char choice;

    if (mode == 1) {
        if (current_turn == 0) {
            printf("\nИгрок 1 ходит первым! Выберите чем играть (X или 0): ");
            scanf(" %c", &choice);
            if (choice == '0' || choice == 'O' || choice == 'o') { p1_sym = '0'; p2_sym = 'X'; }
            else { p1_sym = 'X'; p2_sym = '0'; }
        }
        else {
            printf("\nИгрок 2 ходит первым! Выберите чем играть (X или 0): ");
            scanf(" %c", &choice);
            if (choice == '0' || choice == 'O' || choice == 'o') { p2_sym = '0'; p1_sym = 'X'; }
            else { p2_sym = 'X'; p1_sym = '0'; }
        }
    }
    else {
        if (current_turn == 0) {
            printf("\nВы ходите первым! Выберите чем играть (X или 0): ");
            scanf(" %c", &choice);
            if (choice == '0' || choice == 'O' || choice == 'o') { p1_sym = '0'; p2_sym = 'X'; }
            else { p1_sym = 'X'; p2_sym = '0'; }
        }
        else {
            if (rand() % 2 == 0) { p2_sym = 'X'; p1_sym = '0'; }
            else { p2_sym = '0'; p1_sym = 'X'; }
            printf("\nБот ходит первым! Он выбрал %c. Вы играете за %c.\n", p2_sym, p1_sym);
        }
    }

    int game_over = 0;

    while (!game_over) {
        print_board();

        if (current_turn == 0) {
            int row, col;
            if (mode == 1) printf("Ход Игрока 1 (%c) (строка столбец): ", p1_sym);
            else printf("Ваш ход (%c) (строка столбец): ", p1_sym);

            if (scanf("%d %d", &row, &col) != 2) {
                printf("Неверный ввод.\n");
                while (getchar() != '\n');
                continue;
            }

            row--; col--;

            if (row < 0 || row >= size || col < 0 || col >= size) {
                printf("Вне поля. Введите от 1 до %d.\n", size);
                continue;
            }
            if (board[row][col] != ' ') {
                printf("Клетка занята.\n");
                continue;
            }

            board[row][col] = p1_sym;

            if (check_win(p1_sym)) {
                print_board();
                if (mode == 1) printf("Игрок 1 победил!\n");
                else printf("Вы победили!\n");
                game_over = 1;
            }
            else if (is_full()) {
                print_board();
                printf("Ничья.\n");
                game_over = 1;
            }
            else {
                current_turn = 1;
            }

        }
        else {
            if (mode == 1) {
                int row, col;
                printf("Ход Игрока 2 (%c) (строка столбец): ", p2_sym);

                if (scanf("%d %d", &row, &col) != 2) {
                    printf("Неверный ввод.\n");
                    while (getchar() != '\n');
                    continue;
                }

                row--; col--;

                if (row < 0 || row >= size || col < 0 || col >= size) {
                    printf("Вне поля. Введите от 1 до %d.\n", size);
                    continue;
                }
                if (board[row][col] != ' ') {
                    printf("Клетка занята.\n");
                    continue;
                }

                board[row][col] = p2_sym;

                if (check_win(p2_sym)) {
                    print_board();
                    printf("Игрок 2 победил!\n");
                    game_over = 1;
                }
                else if (is_full()) {
                    print_board();
                    printf("Ничья.\n");
                    game_over = 1;
                }
                else {
                    current_turn = 0;
                }
            }
            else {
                bot_move(p2_sym);

                if (check_win(p2_sym)) {
                    print_board();
                    printf("Бот победил.\n");
                    game_over = 1;
                }
                else if (is_full()) {
                    print_board();
                    printf("Ничья.\n");
                    game_over = 1;
                }
                else {
                    current_turn = 0;
                }
            }
        }
    }

    return 0;
}
